# Cloudinary Configuration
# Get these from your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Next.js
NEXT_PUBLIC_BASE_URL=https://www.jadecommelecailloux.com

# Admin password (set in Vercel Environment Variables, NOT here!)
# ADMIN_PASSWORD=your_secure_password_here

# Required only when enabling the maintenance gate. Use a separate strong password.
# MAINTENANCE_PASSWORD=your_private_site_access_password

# DeepL API key for automatic artwork translations into English and German
# DEEPL_AUTH_KEY=your_deepl_api_key

# Stripe Checkout (test mode only; never commit real keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
